# Compose project name — isolates volumes/networks/containers from other
# environments running the same stack on this host. Defaults to the directory
# name; setting it explicitly protects against collisions if folders are
# renamed or copied. See docs/briska-blast-ops-manual.md for details.
# COMPOSE_PROJECT_NAME=briska-prod

# Host-side bind address for Docker port mappings.
# Defaults to 127.0.0.1 (loopback-only, safe behind a reverse proxy).
# WARNING: 0.0.0.0 bypasses nginx — no TLS, no IP allowlisting, no rate limiting.
# BIND_ADDR=0.0.0.0

# Port overrides — change if defaults conflict with other services.
# Follow the tens-digit pattern: prod=2591x, staging=2592x, dev=2593x
# GAME_PORT=25919
# ADMIN_PORT=25920
# WATCHTOWER_PORT=25921

# Release channel for this deployment: stable | ea | dev
# REQUIRED: docker-compose.yml fails fast if this is unset (no default in compose
# to avoid running the wrong channel by accident). Must match the Docker image
# tag you intend to run and receive updates for.
RELEASE_CHANNEL=stable

# Watchtower shared secret — must match between server and watchtower services.
# REQUIRED: docker-compose.yml fails fast if this is unset (no default in compose
# to avoid a missing .env silently running with a public token).
# Pick a long random string before deploying.
WATCHTOWER_TOKEN=please-set-a-real-token-here

# Optional GitHub Personal Access Token (read-only, no scopes needed) used by
# the server's auto-update check against the public Releases API. Without it,
# checks are anonymous (60 req/hr/IP shared with everything else on the host).
# With it, the limit raises to 5000 req/hr authenticated.
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Optional Cloudflare TURN key (dashboard: Realtime → TURN keys → Create).
# The server mints short-lived TURN relay credentials from these and hands
# them to game clients at match start, so peers behind symmetric NATs can
# still connect (relayed). Unset ⇒ TURN disabled: clients fall back to
# STUN-only and symmetric-NAT peer pairs will fail to connect. The API token
# never leaves the server.
# TURN_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TURN_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional Pocket ID (OIDC) login for the /admin panel. When all four are set,
# the panel shows "Sign in with Pocket ID" and controls access by Pocket ID
# group membership (briska-superadmin / briska-admin / briska-moderator).
# Unset ⇒ the panel falls back to plain password login (fail-open). Create a
# CONFIDENTIAL OIDC client in Pocket ID (Public Client OFF) and register the
# callback shown below. ADMIN_PUBLIC_URL is the panel's externally-reachable
# origin; the callback is derived as {ADMIN_PUBLIC_URL}/admin/oidc/callback —
# add that exact URL to the Pocket ID client's Callback URLs. OIDC_ISSUER_URL
# is the Pocket ID base URL, NOT the /.well-known/... discovery URL. The client
# secret never leaves the server.
# ADMIN_PUBLIC_URL=https://briskadev.phoenixwired.com
# OIDC_ISSUER_URL=https://pocketid.phoenixwired.com
# OIDC_CLIENT_ID=00000000-0000-0000-0000-000000000000
# OIDC_CLIENT_SECRET=shown-once-at-client-creation
#
# Group-name prefix so each deployment gates on DISTINCT groups: the server
# authorizes against {prefix}superadmin / {prefix}admin / {prefix}moderator.
# Default "briska-" (⇒ briska-superadmin / briska-admin / briska-moderator).
# Give ea/stable their own prefix so their admins are separate from dev's,
# e.g. OIDC_GROUP_PREFIX=briska-ea-  (then create matching groups in Pocket ID).
# OIDC_GROUP_PREFIX=briska-

# Optional secret PEPPER for the break-glass admin password. When set, the
# emergency password is HMAC-SHA256'd with this key before bcrypt, so a
# Redis-only leak can't brute-force the hash. Empty ⇒ plain bcrypt (backward
# compatible). WARNING: changing this after the hash is stored invalidates it —
# the break-glass password stops working until you reset it (clear the
# admin:password_hash Redis key so it re-seeds from ADMIN_PASSWORD, or set a new
# one from the panel). Pocket ID login is unaffected. Generate with
# `openssl rand -hex 32`.
# BREAK_GLASS_PEPPER=

# Optional secret PEPPER for the admin Logs tab's client-IP ⟨ip:…⟩ tokens (HMAC
# of this key, computed fresh at render). LEAVE UNSET for normal use — a random
# per-boot key is used and correlation within any single view/download works
# regardless. Only set it if you need tokens STABLE ACROSS RESTARTS — i.e. you
# compare saved Download .log files across a redeploy, or build the durable
# audit stream that STORES tokenized events. Nothing today depends on it.
# Generate with `openssl rand -hex 32`. Never leaves the server.
# IP_HASH_PEPPER=
