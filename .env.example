# Compose project name — isolates volumes/networks/containers from other
# environments running the same stack on this host. Defaults to the directory
# name; setting it explicitly protects against collisions if folders are
# renamed or copied. See docs/briska-blast-ops-manual.md for details.
# COMPOSE_PROJECT_NAME=briska-prod

# Host-side bind address for Docker port mappings.
# Defaults to 127.0.0.1 (loopback-only, safe behind a reverse proxy).
# WARNING: 0.0.0.0 bypasses nginx — no TLS, no IP allowlisting, no rate limiting.
# BIND_ADDR=0.0.0.0

# Port overrides — change if defaults conflict with other services.
# Follow the tens-digit pattern: prod=2591x, staging=2592x, dev=2593x
# GAME_PORT=25919
# ADMIN_PORT=25920
# WATCHTOWER_PORT=25921

# Release channel for this deployment: stable | ea | dev
# REQUIRED: docker-compose.yml fails fast if this is unset (no default in compose
# to avoid running the wrong channel by accident). Must match the Docker image
# tag you intend to run and receive updates for.
RELEASE_CHANNEL=stable

# Watchtower shared secret — must match between server and watchtower services.
# REQUIRED: docker-compose.yml fails fast if this is unset (no default in compose
# to avoid a missing .env silently running with a public token).
# Pick a long random string before deploying.
WATCHTOWER_TOKEN=please-set-a-real-token-here

# Optional GitHub Personal Access Token (read-only, no scopes needed) used by
# the server's auto-update check against the public Releases API. Without it,
# checks are anonymous (60 req/hr/IP shared with everything else on the host).
# With it, the limit raises to 5000 req/hr authenticated.
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Optional Cloudflare TURN key (dashboard: Realtime → TURN keys → Create).
# The server mints short-lived TURN relay credentials from these and hands
# them to game clients at match start, so peers behind symmetric NATs can
# still connect (relayed). Unset ⇒ TURN disabled: clients fall back to
# STUN-only and symmetric-NAT peer pairs will fail to connect. The API token
# never leaves the server.
# TURN_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TURN_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
