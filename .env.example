# Host-side bind address for Docker port mappings.
# Defaults to 127.0.0.1 (loopback-only, safe behind a reverse proxy).
# WARNING: 0.0.0.0 bypasses nginx — no TLS, no IP allowlisting, no rate limiting.
# BIND_ADDR=0.0.0.0

# Port overrides — change if defaults conflict with other services.
# Follow the tens-digit pattern: prod=2591x, staging=2592x, dev=2593x
# GAME_PORT=25919
# ADMIN_PORT=25920
# WATCHTOWER_PORT=25921

# Release channel for this deployment: stable | ea | dev
# Must match the Docker image tag you intend to run and receive updates for.
# RELEASE_CHANNEL=stable

# Watchtower shared secret — must match between server and watchtower services.
# Change this from the default before deploying.
# WATCHTOWER_TOKEN=briska-watchtower-token
