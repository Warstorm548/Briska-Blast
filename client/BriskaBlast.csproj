<Project Sdk="Godot.NET.Sdk/4.6.3">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>BriskaBlast</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!--
    Compile-time channel + server-host bake.
    Mirrors server/build.rs:1-5. RELEASE_CHANNEL env var selects which
    server this client variant can ever talk to. See CLAUDE.md.
  -->
  <PropertyGroup>
    <ReleaseChannel Condition="'$(ReleaseChannel)' == ''">$(RELEASE_CHANNEL)</ReleaseChannel>
    <ReleaseChannel Condition="'$(ReleaseChannel)' == ''">dev</ReleaseChannel>

    <ServerHost Condition="'$(ReleaseChannel)' == 'dev'">briskadev.phoenixwired.com</ServerHost>
    <ServerHost Condition="'$(ReleaseChannel)' == 'ea'">briskaea.phoenixwired.com</ServerHost>
    <ServerHost Condition="'$(ReleaseChannel)' == 'stable'">briska.phoenixwired.com</ServerHost>
  </PropertyGroup>

  <!--
    Per-channel OUTPUT assembly name. The game's self-contained .NET runtime
    extracts to a folder named data_<AssemblyName>_<platform>, so a distinct
    name per channel keeps their runtime caches from colliding once more than
    one channel is installed. This MUST match project.godot's
    `project/assembly_name` (set per channel by release-client.yml) AND the
    launcher's Channel::cache_basename() — a mismatch breaks Godot's internal
    dotnet-publish/embed step (empty .pck). RootNamespace stays "BriskaBlast"
    so no C# namespaces change. Stable keeps the bare name.
  -->
  <PropertyGroup>
    <AssemblyName Condition="'$(ReleaseChannel)' == 'ea'">BriskaBlastEA</AssemblyName>
    <AssemblyName Condition="'$(ReleaseChannel)' == 'dev'">BriskaBlastDev</AssemblyName>
    <AssemblyName Condition="'$(AssemblyName)' == ''">BriskaBlast</AssemblyName>
  </PropertyGroup>

  <!--
    BuildConfig.cs is generated by GenerateBuildConfig (below) and is
    git-ignored ("do not commit" — it's channel-specific). Remove it from
    the SDK's default source glob, which is evaluated BEFORE any target runs:
    in a fresh checkout (CI) the file doesn't exist at glob time, so it would
    never be compiled and any reference to BuildConfig fails with CS0103. The
    target re-adds it to @(Compile) after writing it, so compilation is
    consistent whether or not the file already exists on disk.
  -->
  <ItemGroup>
    <Compile Remove="src/core/BuildConfig.cs" />
  </ItemGroup>

  <Target Name="GenerateBuildConfig" BeforeTargets="CoreCompile">
    <Error
      Condition="'$(ReleaseChannel)' != 'dev' AND '$(ReleaseChannel)' != 'ea' AND '$(ReleaseChannel)' != 'stable'"
      Text="RELEASE_CHANNEL must be one of: dev, ea, stable (got '$(ReleaseChannel)')." />

    <ItemGroup>
      <_BuildConfigLine Include="// &lt;auto-generated /&gt;" />
      <_BuildConfigLine Include="// Generated by the GenerateBuildConfig MSBuild target." />
      <_BuildConfigLine Include="// Do not edit%3B do not commit. See client/BriskaBlast.csproj." />
      <_BuildConfigLine Include="namespace BriskaBlast.Core%3B" />
      <_BuildConfigLine Include="public static class BuildConfig" />
      <_BuildConfigLine Include="{" />
      <_BuildConfigLine Include="    public const string Channel = &quot;$(ReleaseChannel)&quot;%3B" />
      <_BuildConfigLine Include="    public const string ServerHost = &quot;$(ServerHost)&quot;%3B" />
      <_BuildConfigLine Include="}" />
    </ItemGroup>

    <WriteLinesToFile
      File="$(MSBuildProjectDirectory)/src/core/BuildConfig.cs"
      Lines="@(_BuildConfigLine)"
      Overwrite="true"
      WriteOnlyWhenDifferent="true" />

    <!-- Add the just-written file to the compile set. CoreCompile reads
         @(Compile) when it runs (after this target), so this inclusion takes
         effect even though the file was absent at glob-evaluation time. -->
    <ItemGroup>
      <Compile Include="src/core/BuildConfig.cs" />
    </ItemGroup>
  </Target>
</Project>
