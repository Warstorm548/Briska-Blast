<Project Sdk="Godot.NET.Sdk/4.6.3">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>BriskaBlast</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!--
    Compile-time channel + server-host bake.
    Mirrors server/build.rs:1-5. RELEASE_CHANNEL env var selects which
    server this client variant can ever talk to. See CLAUDE.md.
  -->
  <PropertyGroup>
    <ReleaseChannel Condition="'$(ReleaseChannel)' == ''">$(RELEASE_CHANNEL)</ReleaseChannel>
    <ReleaseChannel Condition="'$(ReleaseChannel)' == ''">dev</ReleaseChannel>

    <ServerHost Condition="'$(ReleaseChannel)' == 'dev'">briskadev.phoenixwired.com</ServerHost>
    <ServerHost Condition="'$(ReleaseChannel)' == 'ea'">briskaea.phoenixwired.com</ServerHost>
    <ServerHost Condition="'$(ReleaseChannel)' == 'stable'">briska.phoenixwired.com</ServerHost>
  </PropertyGroup>

  <Target Name="GenerateBuildConfig" BeforeTargets="CoreCompile">
    <Error
      Condition="'$(ReleaseChannel)' != 'dev' AND '$(ReleaseChannel)' != 'ea' AND '$(ReleaseChannel)' != 'stable'"
      Text="RELEASE_CHANNEL must be one of: dev, ea, stable (got '$(ReleaseChannel)')." />

    <ItemGroup>
      <_BuildConfigLine Include="// &lt;auto-generated /&gt;" />
      <_BuildConfigLine Include="// Generated by the GenerateBuildConfig MSBuild target." />
      <_BuildConfigLine Include="// Do not edit%3B do not commit. See client/BriskaBlast.csproj." />
      <_BuildConfigLine Include="namespace BriskaBlast.Core%3B" />
      <_BuildConfigLine Include="public static class BuildConfig" />
      <_BuildConfigLine Include="{" />
      <_BuildConfigLine Include="    public const string Channel = &quot;$(ReleaseChannel)&quot;%3B" />
      <_BuildConfigLine Include="    public const string ServerHost = &quot;$(ServerHost)&quot;%3B" />
      <_BuildConfigLine Include="}" />
    </ItemGroup>

    <WriteLinesToFile
      File="$(MSBuildProjectDirectory)/src/core/BuildConfig.cs"
      Lines="@(_BuildConfigLine)"
      Overwrite="true"
      WriteOnlyWhenDifferent="true" />
  </Target>
</Project>
