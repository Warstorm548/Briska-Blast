; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Briska Blast"
config/version="0.2.1"
config/description="Cross-platform multiplayer paddle/ball game."
run/main_scene="res://src/ui/menus/MainMenu.tscn"
config/features=PackedStringArray("4.6", "C#", "Forward Plus")

[autoload]

SettingsManager="*res://src/core/SettingsManager.cs"
SessionContext="*res://src/core/SessionContext.cs"

[display]

window/size/viewport_width=2560
window/size/viewport_height=1440
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="BriskaBlast"
