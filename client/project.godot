; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Briska Blast"
config/description="Cross-platform multiplayer paddle/ball game."
config/version="0.34.1"
run/main_scene="res://src/ui/menus/MainMenu.tscn"
config/features=PackedStringArray("4.6", "C#", "Forward Plus")

[autoload]

SpriteRegistry="*res://src/core/SpriteRegistry.cs"
SettingsManager="*res://src/core/SettingsManager.cs"
SingleInstance="*res://src/core/SingleInstance.cs"
Log="*res://src/core/Log.cs"
SessionContext="*res://src/core/SessionContext.cs"
MatchFlow="*res://src/core/MatchFlow.cs"

[display]

window/size/viewport_width=2560
window/size/viewport_height=1440
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="BriskaBlast"

