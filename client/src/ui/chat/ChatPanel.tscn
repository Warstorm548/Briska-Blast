[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://src/ui/chat/ChatPanel.cs" id="1_script"]
[ext_resource type="Theme" path="res://src/ui/theme/MenuTheme.tres" id="2_theme"]

[node name="ChatPanel" type="PanelContainer"]
theme = ExtResource("2_theme")
theme_type_variation = &"InnerPanel"
script = ExtResource("1_script")

[node name="Margins" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 12

[node name="Content" type="VBoxContainer" parent="Margins"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="NoticeRow" type="HBoxContainer" parent="Margins/Content"]
unique_name_in_owner = true
layout_mode = 2
visible = false

[node name="NoticeLabel" type="Label" parent="Margins/Content/NoticeRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
autowrap_mode = 3

[node name="NoticeDismiss" type="Button" parent="Margins/Content/NoticeRow"]
unique_name_in_owner = true
layout_mode = 2
text = "✕"

[node name="ChatHeader" type="Label" parent="Margins/Content"]
unique_name_in_owner = true
layout_mode = 2
text = "Chat"
theme_override_font_sizes/font_size = 22

[node name="ChatLog" type="RichTextLabel" parent="Margins/Content"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
bbcode_enabled = true
scroll_following = true
autowrap_mode = 3

[node name="ChatInput" type="LineEdit" parent="Margins/Content"]
unique_name_in_owner = true
layout_mode = 2
placeholder_text = "Chat message field"
